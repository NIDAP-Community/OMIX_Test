{
  "run_label": "volcano_example",
  "inputs": {
    "deg_table_file": "data/example_inputs/deg_table.csv"
  },
  "function_args": {
    "function_name": "volcano_plot_enhanced",
    "deg_table": "deg_results",
    "column_with_feature_id": "Gene",
    "significance_column": ["A-B_adjpval", "A-C_adjpval", "B-C_adjpval"],
    "log2_fold_change_column": ["A-B_logFC", "A-C_logFC", "B-C_logFC"],
    "p_value_threshold": 0.05,
    "log2_fold_change_threshold": 1,
    "choose_feature_to_label_by": "p-value",
    "number_of_features_to_label": 5,
    "label_only_my_feature_list": false,
    "use_custom_axis_label": false,
    "my_feature_list": "",
    "top_genes_labeled_only_if_passing_thresholds": true,
    "label_size": 4,
    "custom_significance_label": "p-value",
    "custom_log_fold_change_label": "log2FC",
    "plot_title": "Volcano Plots",
    "y_limit": 0,
    "use_auto_axis_capping": true,
    "auto_axis_capping_quantile": 0.995,
    "auto_axis_capping_min_y_limit": 0,
    "auto_axis_capping_symmetric_x": true,
    "custom_x_axis_limits": "",
    "x_limit_padding": 0,
    "y_limit_padding": 0,
    "axis_label_size": 24,
    "point_size": 2,
    "image_width": 1800,
    "image_height": 1800,
    "resolution_dpi_": 150
  }
}
